{
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": ".",
    "testEnvironment": "node",
    "testRegex": ".e2e-spec.ts$",
    "transform": {
        "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
        "middleware/middleware/(.*)": "<rootDir>/../libs/middleware/src/$1",
        "middleware/middleware": "<rootDir>/../libs/middleware/src",
        "types/types/(.*)": "<rootDir>/../libs/types/src/$1",
        "types/types": "<rootDir>/../libs/types/src",
        "@app/types/(.*)": "<rootDir>/../libs/types/src/$1",
        "@app/types": "<rootDir>/../libs/types/src",
        "@app/config/(.*)": "<rootDir>/../libs/config/src/$1",
        "@app/config": "<rootDir>/../libs/config/src",
        "@app/exception/(.*)": "<rootDir>/../libs/exception/src/$1",
        "@app/exception": "<rootDir>/../libs/exception/src"
    }
}
